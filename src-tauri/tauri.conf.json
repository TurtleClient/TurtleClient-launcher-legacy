{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Turtle Launcher",
  "version": "0.1.0",
  "identifier": "dev.turtleclient.launcher",
  "build": {"beforeBuildCommand":"npm run build","beforeDevCommand":"npm run dev","devUrl":"http://localhost:5173","frontendDist":"../dist"},
  "app": {
    "windows":[{"title":"Turtle Launcher","label":"main","width":1120,"height":760,"minWidth":940,"minHeight":680,"center":true}],
    "security":{"csp":"default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active":true,"targets":["nsis"],"category":"Game","publisher":"TurtleClient",
    "copyright":"TurtleClient; original launcher © CCBlueX",
    "shortDescription":"Native TurtleClient launcher for Minecraft 26.3",
    "license":"GPL-3.0-or-later","licenseFile":"../LICENSE",
    "resources":{"payload/":"payload/"},
    "icon":["icons/32x32.png","icons/128x128.png","icons/icon.ico"],
    "windows":{"webviewInstallMode":{"type":"downloadBootstrapper"},"nsis":{"installMode":"currentUser","languages":["German","English"],"displayLanguageSelector":true}}
  }
}
